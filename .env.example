# ==============================================================================
# PolliBazar Environment Variables Template
# DO NOT store real production secrets in this file or commit .env to GitHub!
# ==============================================================================

# Application & Cloudflare Environment
ENVIRONMENT="production"
SITE_NAME="PolliBazar"
SITE_URL="https://pollibazar.pages.dev"

# Admin Authentication & Sessions
ADMIN_SECRET="your-strong-random-session-secret-key-min-32-chars"

# Cloudflare D1 Database Binding (Configured via wrangler.toml & Cloudflare Pages dashboard)
# Database Name: pollibazar-db
# Binding Name: DB

# Optional AI Features & Hosting URL
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
APP_URL="https://pollibazar.pages.dev"
